# LoopBreak AI — Backend Environment Configuration

# ============================================
# AI CONFIGURATION
# ============================================
# Get your free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (free-tier compatible)
GEMINI_MODEL=gemini-2.0-flash

# AI provider (gemini | demo)
AI_PROVIDER=gemini

# AI mode: auto | ai | demo
# auto = use AI if key present, else demo
# ai   = require AI (fail if no key)
# demo = always use demo engine
AI_MODE=auto

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./loopbreak.db

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ============================================
# CORS
# ============================================
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# SEMANTIC SIMILARITY
# ============================================
# Use local embeddings (requires sentence-transformers download)
USE_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.75

